# Copy to .env.prod on the VPS and fill in real values — never commit
# .env.prod (it's gitignored, same pattern as apps/api/.env).
#
# DOMAIN must resolve (DNS A record) to this VPS's IP before Traefik can
# issue a Let's Encrypt cert for it.
DOMAIN=harmon.fasolo.tech

# The dev docker-compose.yml hardcodes "harmon"/"harmon" — there's no
# existing value to reuse here, generate one: openssl rand -hex 32
POSTGRES_PASSWORD=

# apps/api/src/env.ts requires 32+ chars. Project decision: reuse the same
# value already in apps/api/.env rather than mint a separate prod secret.
JWT_SECRET=

# Google OAuth client ID — public by design, reuse from apps/api/.env.
GOOGLE_CLIENT_ID=

# Resend — project decision: reuse the same values already in apps/api/.env.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
